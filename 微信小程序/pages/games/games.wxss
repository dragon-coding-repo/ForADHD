.starrail {
  background: linear-gradient(135deg, #0E332E, #11594B); color: #fff;
  border-radius: 36rpx; padding: 32rpx 36rpx; margin: 24rpx;
  display: flex; align-items: center; gap: 28rpx;
}
.starrail .big { font-size: 68rpx; font-weight: 800; }
.railtxt .lbl { font-size: 25rpx; color: #9DC9BE; margin-top: 4rpx; }

.gcard {
  display: flex; align-items: center; gap: 28rpx; background: #fff;
  border-radius: 32rpx; padding: 32rpx; margin: 0 24rpx 24rpx; text-align: left; width: auto;
  box-shadow: 0 2rpx 8rpx rgba(20, 50, 44, 0.06);
}
.gcard-hover { transform: scale(0.985); background: #F6FAF8; }
.gic { width: 108rpx; height: 108rpx; border-radius: 28rpx; display: flex; align-items: center; justify-content: center; font-size: 54rpx; flex: none; }
.gic-green { background: #E8F5E9; }
.gic-gold { background: #FFF4D6; }
.gic-orange { background: #FBE9E2; }
.gt1 { font-size: 33rpx; font-weight: 800; }
.gt2 { font-size: 25rpx; color: #68766F; margin-top: 4rpx; }
.skill { font-size: 22rpx; background: #E7F3EF; color: #177E6A; border-radius: 12rpx; padding: 4rpx 14rpx; display: inline-block; margin-top: 10rpx; font-weight: 700; }

.howto { font-size: 26rpx; color: #68766F; line-height: 1.8; }
.howto-b { color: #22312C; font-weight: 700; }
.hist { display: flex; justify-content: space-between; font-size: 25rpx; color: #68766F; padding: 14rpx 4rpx; border-bottom: 1rpx solid #E3E9E6; }
.hist:last-child { border-bottom: none; }
